# Application
APP_NAME=BaliGuideMapAPI
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=bali_guide_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081

# Tanya Loka (AI guide). Leave empty to disable the feature.
ANTHROPIC_API_KEY=

# Admin account for the web admin panel. Created on startup if the email does
# not exist yet; an existing user with this email is promoted to admin.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@baliguide.local
ADMIN_PASSWORD=change-this-admin-password

# Google Sign-In. Comma-separated OAuth client IDs whose ID tokens are accepted.
# Use the "Web client" ID from Google Cloud (the same value the app passes as
# serverClientId). Leave empty to disable POST /auth/google.
GOOGLE_CLIENT_IDS=

# Trip planner ("Rencana Kunjungan"). Server-side only; never ship this key in
# the mobile app. Leave empty to disable POST /planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Folder for admin-uploaded images, served at /uploads. Keep it on a
# persistent disk in production.
UPLOAD_DIR=uploads
